<svg class="illu illu-smartphone" viewBox="0 0 400 300" role="img" aria-label="Un tablet e uno smartphone con la tastiera sullo schermo, emoji e un microfono">
  <circle class="i-background sn" cx="200" cy="150" r="130" />
  <g class="tablet">
    <rect class="i-ink" x="24" y="40" width="210" height="226" rx="20" />
    <rect class="i-paper" x="36" y="54" width="186" height="198" rx="8" />
    <rect class="i-lightblue sn-l" x="46" y="68" width="120" height="22" rx="11" />
    <rect class="i-white sn-l" x="112" y="100" width="100" height="22" rx="11" />
    <g class="suggestions">
      <rect class="i-yellow sn-l" x="44" y="144" width="52" height="16" rx="8" />
      <rect class="i-yellow sn-l" x="102" y="144" width="52" height="16" rx="8" />
      <rect class="i-yellow sn-l" x="160" y="144" width="52" height="16" rx="8" />
    </g>
    <g class="minikeys-v">
      {{ for r of [0, 1, 2] }}
      {{ for c of [0, 1, 2, 3, 4, 5, 6, 7, 8] }}
      <rect class="i-white sn-l" x="{{ 44 + c * 19.5 + r * 4 }}" y="{{ 168 + r * 20 }}" width="16" height="16" rx="3" />
      {{ /for }}
      {{ /for }}
      <rect class="i-white sn-l" x="84" y="230" width="90" height="14" rx="4" />
    </g>
    <circle class="touch tc1" cx="92" cy="176" r="10" />
    <circle class="touch tc2" cx="150" cy="196" r="10" />
  </g>
  <g class="phone">
    <rect class="i-pink" x="252" y="70" width="112" height="200" rx="22" />
    <rect class="i-paper" x="262" y="90" width="92" height="160" rx="8" />
    <rect class="i-ink sn" x="292" y="78" width="32" height="6" rx="3" />
    <g class="minikeys-v">
      {{ for r of [0, 1, 2] }}
      {{ for c of [0, 1, 2, 3, 4, 5] }}
      <rect class="i-white sn-l" x="{{ 267 + c * 14 + r * 2 }}" y="{{ 180 + r * 16 }}" width="11" height="12" rx="2" />
      {{ /for }}
      {{ /for }}
      <rect class="i-white sn-l" x="284" y="230" width="50" height="10" rx="3" />
    </g>
    <circle class="touch tc3" cx="296" cy="202" r="7" />
    <g class="microphone">
      <rect class="i-blue" x="300" y="112" width="16" height="30" rx="8" />
      <path class="sn-f" d="M292 132a16 16 0 0 0 32 0M308 148v10" />
    </g>
  </g>
  <text class="flying-emoji e1" x="230" y="60">😀</text>
  <text class="flying-emoji e2" x="360" y="56">🎉</text>
  <text class="flying-emoji e3" x="200" y="40">❤️</text>
</svg>

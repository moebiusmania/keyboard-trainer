<svg class="mascot {{ className || '' }}" viewBox="0 0 120 132" aria-hidden="true" data-mood="happy">
  <ellipse class="mascot-shadow" cx="60" cy="126" rx="34" ry="5" />
  <g class="mascot-body">
    <g class="mascot-legs">
      <rect x="38" y="100" width="11" height="22" rx="5.5" />
      <rect x="71" y="100" width="11" height="22" rx="5.5" />
      <ellipse cx="40" cy="122" rx="10" ry="5" />
      <ellipse cx="80" cy="122" rx="10" ry="5" />
    </g>
    <path class="mascot-arm mascot-arm--left" d="M16 64 q-14 -4 -12 -20" />
    <path class="mascot-arm mascot-arm--right" d="M104 64 q14 -4 12 -20" />
    <rect class="mascot-side" x="10" y="18" width="100" height="90" rx="22" />
    <rect class="mascot-face" x="20" y="10" width="80" height="74" rx="18" />
    <path class="mascot-highlight" d="M30 22 q0 -4 6 -4 h18" />
    <g class="mascot-eyes">
      <ellipse cx="45" cy="42" rx="7" ry="9" />
      <ellipse cx="75" cy="42" rx="7" ry="9" />
      <circle class="mascot-glint" cx="47.5" cy="38.5" r="2.6" />
      <circle class="mascot-glint" cx="77.5" cy="38.5" r="2.6" />
    </g>
    <ellipse class="mascot-cheek" cx="34" cy="58" rx="6.5" ry="4" />
    <ellipse class="mascot-cheek" cx="86" cy="58" rx="6.5" ry="4" />
    <path class="mascot-mouth mascot-mouth--happy" d="M49 58 q11 14 22 0 z" />
    <ellipse class="mascot-mouth mascot-mouth--oh" cx="60" cy="62" rx="6" ry="7" />
    <path class="mascot-mouth mascot-mouth--party" d="M44 55 q16 26 32 0 z" />
  </g>
</svg>

{{ set ui = search.page("id=interface") }}
<!doctype html>
<html lang="{{ lang }}" data-area="{{ area || 'home' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {{ set pageDescription = description || ui.description }}
  <title>{{ if title == ui.site_name }}{{ ui.site_name }} · {{ ui.description }}{{ else }}{{ title }} · {{ ui.site_name }}{{ /if }}</title>
  <meta name="description" content="{{ pageDescription |> escape }}">
  <link rel="canonical" href="{{ url |> url(true) }}">

  <!-- Preview when the link is shared (Open Graph and X/Twitter) -->
  <meta property="og:type" content="website">
  <meta property="og:locale" content="it_IT">
  <meta property="og:site_name" content="{{ ui.site_name }}">
  <meta property="og:title" content="{{ title |> escape }}">
  <meta property="og:description" content="{{ pageDescription |> escape }}">
  <meta property="og:url" content="{{ url |> url(true) }}">
  <meta property="og:image" content="{{ ui.preview.image |> url(true) }}">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ ui.preview.alt |> escape }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="color-scheme" content="light">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.bunny.net">
  <link rel="stylesheet" href="https://fonts.bunny.net/css?family=andika:400,700|fredoka:400,500,600,700&display=swap">
  <link rel="stylesheet" href="/styles/main.css">
  <script>
    try { if (JSON.parse(localStorage.getItem("tasto-dopo-tasto:audio")) === false) document.documentElement.dataset.audio = "off"; } catch {}
  </script>
  <script type="module" src="/js/common.js"></script>
  {{ if script }}<script type="module" src="{{ script }}"></script>{{ /if }}
</head>
<body>
  <a class="skip" href="#content">{{ ui.skip_to_content }}</a>
  <header class="header">
    <a class="logo" href="/" aria-label="{{ ui.site_name }} – {{ ui.menu[0].text }}">
      {{ include "partials/mascot.vto" { className: "mascot--logo" } }}
      <span class="logo-text">{{ ui.site_name }}</span>
    </a>
    <nav class="menu" aria-label="Menu">
      <ul>
        {{ for item of ui.menu }}
        <li><a href="{{ item.url }}"{{ if item.url == url }} aria-current="page"{{ /if }}>{{ item.text }}</a></li>
        {{ /for }}
      </ul>
    </nav>
    <button class="audio-button" type="button" aria-pressed="true" aria-label="{{ ui.audio }}" title="{{ ui.audio }}">
      <svg viewBox="0 0 32 32" aria-hidden="true">
        <path class="speaker" d="M5 12h6l7-6v20l-7-6H5z" />
        <path class="waves" d="M22 11q4 5 0 10M25.5 7.5q7 8.5 0 17" />
        <path class="muted" d="M22 12l8 8M30 12l-8 8" />
      </svg>
    </button>
  </header>

  <main id="content" class="content">
    {{ content }}
  </main>

  <footer class="footer">
    <p>{{ ui.footer }}</p>
    <p class="footer-license">
      {{ ui.license.authors }} ·
      {{ ui.license.before }} <a rel="license" href="{{ ui.license.url }}">{{ ui.license.name }}</a>:
      {{ ui.license.after }}
    </p>
  </footer>
</body>
</html>

---
layout: layouts/base.vto
script: /js/story.js
---
{{ set slides = search.pages("type=slide", "order") }}
<section class="story" data-color="{{ color }}">
  <header class="page-header">
    <h1 style="view-transition-name: title-{{ area }}">{{ title }}</h1>
  </header>

  <div class="carousel" role="region" aria-roledescription="carosello" aria-label="{{ title }}">
    <ol class="slides" role="list">
      {{ for i, s of slides }}
      <li class="slide" id="slide-{{ i + 1 }}" data-color="{{ s.color }}" role="group"
          aria-roledescription="slide" aria-label="{{ texts.slide }} {{ i + 1 }} {{ texts.of }} {{ slides.length }}"
          {{ if i > 0 }}hidden{{ /if }}>
        <div class="slide-inner">
        <div class="slide-illustration">
          {{ include "illustrations/" + s.illustration + ".vto" }}
        </div>
        <div class="slide-text">
          <p class="slide-year">{{ s.year }}</p>
          <h2>{{ s.title }}</h2>
          <div class="slide-body">{{ s.content |> md }}</div>
          {{ if s.fact }}
          <aside class="fact">
            <span class="fact-icon" aria-hidden="true">💡</span>
            <p><strong>{{ texts.fact }}</strong> {{ s.fact |> md(true) }}</p>
          </aside>
          {{ /if }}
          {{ if i == slides.length - 1 }}
          <a class="button button--large button--yellow" href="{{ texts.final_url }}">
            {{ texts.final_button }} <span aria-hidden="true">→</span>
          </a>
          {{ /if }}
        </div>
        </div>
      </li>
      {{ /for }}
    </ol>

    <nav class="controls" aria-label="{{ title }}">
      <button class="arrow arrow--back" type="button" data-go="-1" aria-label="{{ texts.previous }}">
        <span aria-hidden="true">←</span>
      </button>
      <ol class="timeline" role="list" style="--steps: {{ slides.length }}">
        {{ for i, s of slides }}
        <li>
          <button type="button" data-slide="{{ i + 1 }}" data-color="{{ s.color }}" aria-label="{{ texts.slide }} {{ i + 1 }}: {{ s.title }}"{{ if i == 0 }} aria-current="step"{{ /if }}>
            <span class="timeline-dot" aria-hidden="true"></span>
            <span class="timeline-year">{{ s.year }}</span>
          </button>
        </li>
        {{ /for }}
      </ol>
      <button class="arrow arrow--forward" type="button" data-go="1" aria-label="{{ texts.next }}">
        <span aria-hidden="true">→</span>
      </button>
    </nav>
    <p class="arrows-hint">⌨️ {{ texts.arrows_hint }}</p>
  </div>
</section>

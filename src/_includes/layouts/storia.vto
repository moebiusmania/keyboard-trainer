---
layout: layouts/base.vto
script: /js/storia.js
---
{{ set slides = search.pages("tipo=slide", "ordine") }}
<section class="storia" data-colore="{{ colore }}">
  <header class="pagina-testa">
    <h1 style="view-transition-name: titolo-{{ nome_area }}">{{ title }}</h1>
  </header>

  <div class="carosello" role="region" aria-roledescription="carosello" aria-label="{{ title }}">
    <ol class="slides" role="list">
      {{ for i, s of slides }}
      <li class="slide" id="slide-{{ i + 1 }}" data-colore="{{ s.colore }}" role="group"
          aria-roledescription="slide" aria-label="{{ testi.slide }} {{ i + 1 }} {{ testi.di }} {{ slides.length }}"
          {{ if i > 0 }}hidden{{ /if }}>
        <div class="slide-interno">
        <div class="slide-illustrazione">
          {{ include "illustrazioni/" + s.illustrazione + ".vto" }}
        </div>
        <div class="slide-testo">
          <p class="slide-anno">{{ s.anno }}</p>
          <h2>{{ s.title }}</h2>
          <div class="slide-corpo">{{ s.content |> md }}</div>
          {{ if s.curiosita }}
          <aside class="curiosita">
            <span class="curiosita-icona" aria-hidden="true">💡</span>
            <p><strong>{{ testi.curiosita }}</strong> {{ s.curiosita |> md(true) }}</p>
          </aside>
          {{ /if }}
          {{ if i == slides.length - 1 }}
          <a class="bottone bottone--grande bottone--giallo" href="{{ testi.finale_url }}">
            {{ testi.finale_bottone }} <span aria-hidden="true">→</span>
          </a>
          {{ /if }}
        </div>
        </div>
      </li>
      {{ /for }}
    </ol>

    <nav class="controlli" aria-label="{{ title }}">
      <button class="freccia freccia--indietro" type="button" data-vai="-1" aria-label="{{ testi.precedente }}">
        <span aria-hidden="true">←</span>
      </button>
      <ol class="linea-tempo" role="list" style="--passi: {{ slides.length }}">
        {{ for i, s of slides }}
        <li>
          <button type="button" data-slide="{{ i + 1 }}" data-colore="{{ s.colore }}" aria-label="{{ testi.slide }} {{ i + 1 }}: {{ s.title }}"{{ if i == 0 }} aria-current="step"{{ /if }}>
            <span class="linea-punto" aria-hidden="true"></span>
            <span class="linea-anno">{{ s.anno }}</span>
          </button>
        </li>
        {{ /for }}
      </ol>
      <button class="freccia freccia--avanti" type="button" data-vai="1" aria-label="{{ testi.successiva }}">
        <span aria-hidden="true">→</span>
      </button>
    </nav>
    <p class="aiuto-frecce">⌨️ {{ testi.aiuto }}</p>
  </div>
</section>

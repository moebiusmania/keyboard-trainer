---
layout: layouts/base.vto
---
<section class="hero">
  <div class="flying-letters" aria-hidden="true">
    {{ for i, l of "ASDFJKLÒQWERTYÈ".split("") }}
    <span style="--i: {{ i }}">{{ l }}</span>
    {{ /for }}
  </div>

  <h1 class="keys-title" aria-label="{{ big_title }}">
    {{ for i, word of big_title.split(" ") }}
    <span class="title-word" aria-hidden="true">
      {{ for j, letter of word.split("") }}
      <span class="title-key" style="--i: {{ i * 6 + j }}">{{ letter }}</span>
      {{ /for }}
    </span>
    {{ /for }}
  </h1>
  <p class="hero-subtitle">{{ subtitle }}</p>

  <div class="hero-mascot">
    {{ include "partials/mascot.vto" { className: "mascot--large mascot--greet" } }}
    <div class="bubble bubble--left">{{ bubble |> md(true) }}</div>
  </div>
</section>

<ul class="areas" role="list">
  {{ for i, area of areas }}
  <li class="area" data-color="{{ area.color }}" style="--i: {{ i }}">
    <a class="area-link" href="{{ area.url }}">
      <span class="area-number" aria-hidden="true">{{ i + 1 }}</span>
      <span class="area-icon" aria-hidden="true">{{ include "illustrations/icon-" + area.name + ".vto" }}</span>
      <h2 class="area-title" style="view-transition-name: title-{{ area.name }}">{{ area.title }}</h2>
      <p class="area-text">{{ area.text }}</p>
      <span class="area-footer">
        <span class="label">⏱ {{ area.duration }}</span>
        <span class="area-action">{{ area.action }} <span aria-hidden="true">→</span></span>
      </span>
    </a>
  </li>
  {{ /for }}
</ul>

<section class="tips">
  <h2>{{ tips_title }}</h2>
  <ol role="list">
    {{ for i, tip of tips }}
    <li style="--i: {{ i }}"><span class="tip-icon" aria-hidden="true">{{ tip.icon }}</span> {{ tip.text }}</li>
    {{ /for }}
  </ol>
</section>

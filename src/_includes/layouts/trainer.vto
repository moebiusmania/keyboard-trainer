---
layout: layouts/base.vto
script: /js/trainer/app.js
---
{{ set ui = search.page("id=interface") }}
{{ set lessons = search.pages("type=" + collection, "order") }}
{{# The link to the challenge is written by the JS, so the base path has to be added here #}}
{{ set textsData = texts }}
{{ if texts.badge?.challenge_url }}
{{ set challengeUrl = texts.badge.challenge_url |> url }}
{{ set textsData = { ...texts, badge: { ...texts.badge, challenge_url: challengeUrl } } }}
{{ /if }}
<section class="trainer" data-mode="{{ mode }}" data-color="{{ color }}">
  <header class="page-header">
    <h1 style="view-transition-name: title-{{ area }}">{{ title }}</h1>
    <div class="page-intro">{{ content }}</div>
  </header>

  <p class="keyboard-notice">{{ ui.keyboard_needed }}</p>

  <div id="app" class="app">
    <noscript><p class="bubble">JavaScript è necessario per giocare.</p></noscript>
  </div>

  <template id="tpl-mascot">{{ include "partials/mascot.vto" { className: "mascot--stage" } }}</template>
  {{ for l of lessons }}
  <template data-intro="{{ l.order }}">{{ l.content |> md }}</template>
  {{ /for }}
  <script type="application/json" id="trainer-data">{{ {
    mode,
    area,
    texts: textsData,
    fingers: ui.fingers,
    lessons: lessons.map((l) => ({
      order: l.order,
      title: l.title,
      emoji: l.emoji,
      new_keys: l.new_keys,
      goal: l.goal,
      stars: l.stars,
      final: l.final,
      steps: l.steps,
    })),
  } |> json }}</script>
</section>
